{
  "tools": [
    {
      "description": "Resolve exactly one top-level Windows window and allocate a stable opaque window_id.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "process_id": {
            "minimum": 1,
            "type": "integer"
          },
          "process_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "title_contains": {
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "windows_find_window"
    },
    {
      "description": "Enumerate a filtered Microsoft UI Automation tree for a resolved window.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "automation_id": {
            "type": "string"
          },
          "class_name": {
            "type": "string"
          },
          "control_type": {
            "type": "string"
          },
          "max_depth": {
            "maximum": 256,
            "minimum": 0,
            "type": "integer"
          },
          "max_elements": {
            "maximum": 20000,
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "name_contains": {
            "type": "string"
          },
          "parent_element_id": {
            "type": "string"
          },
          "view": {
            "default": "control",
            "enum": [
              "control",
              "raw"
            ],
            "type": "string"
          },
          "visible_only": {
            "type": "boolean"
          },
          "window_id": {
            "description": "Opaque Toolkit window identity.",
            "type": "string"
          }
        },
        "required": [
          "window_id"
        ],
        "type": "object"
      },
      "name": "windows_get_control_tree"
    },
    {
      "description": "Resolve exactly one accessible control using server-side filters and return element_id.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "automation_id": {
            "type": "string"
          },
          "class_name": {
            "type": "string"
          },
          "control_type": {
            "type": "string"
          },
          "index": {
            "description": "Zero-based secondary discriminator used only after all other filters.",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "name_contains": {
            "type": "string"
          },
          "parent_element_id": {
            "type": "string"
          },
          "visible_only": {
            "type": "boolean"
