{
  "version": 1,
  "name": "sample-focused-worker-not-run",
  "application": {
    "command": "bin/fixture-app"
  },
  "setup": [
    {
      "op": "session.open",
      "save_session_as": "app"
    }
  ],
  "steps": [
    {
      "op": "get_runtime_health",
      "session": "app"
    },
    {
      "op": "get_runtime_stderr",
      "session": "app"
    }
  ],
  "teardown": [
    {
      "op": "session.close",
      "session": "app"
    }
  ],
  "options": {
    "stop_on_error": true,
    "evidence_on_failure": true
  }
}
