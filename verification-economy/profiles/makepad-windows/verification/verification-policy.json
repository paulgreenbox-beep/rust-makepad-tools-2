        "pointer",
        "keyboard",
        "focus",
        "window",
        "rendering"
      ]
    },
    {
      "id": "unexplained-gui-flake",
      "feature_tags": [
        "unexplained-flake"
      ]
    }
  ],
  "budgets": {
    "focused_new_feature_gui": 4,
    "routine_golden_gui": 4,
    "real_file_gui": 2,
    "frozen_artifact_smoke": 1,
    "typical_gui_runs": 10
  },
  "test_registry": [
    {
      "id": "contract-unit",
      "owner": "windows-ui",
      "level": "L0",
      "workdir": ".",
      "command": "node --test owning-contract.test.mjs"
