  "change_impact": [
    {
      "id": "pure",
      "paths": [
        "src/pure/*"
      ],
      "modules": [
        "pure"
      ],
      "tests": [
        "contract-unit"
      ],
      "feature_tags": [
        "pure"
      ],
      "risk_triggers": []
    },
    {
      "id": "runtime",
      "paths": [
        "src/window_input.rs"
      ],
      "modules": [
        "windows-ui"
      ],
      "tests": [
        "contract-unit",
        "launcher-contract"
      ],
      "feature_tags": [
        "pointer",
        "keyboard",
        "focus",
        "window",
        "rendering"
      ],
      "risk_triggers": [
        "window-identity"
      ]
    },
    {
      "id": "infrastructure",
      "paths": [
        "verification/*"
      ],
      "modules": [
        "verification-infrastructure"
      ],
      "tests": [
        "contract-unit"
      ],
      "feature_tags": [
        "verification-infrastructure"
      ],
      "risk_triggers": []
    }
  ],
  "ownership_rules": {
    "manifest_is_source_of_truth": true,
    "agent_requires_plan_before_gui": true,
    "no_parallel_plugin": true,
    "no_unit_tests_deleted_for_economy": true,
    "assertion_count_not_optimized": true,
    "integration_boundary_not_skipped": true,
    "new_interactions_require_real_user_gui": true,
    "scenario_reuse_requires_exact_artifact_and_source_and_complete_pass": true,
    "unknown_impact_requires_review": true,
    "scenario_recipe_validation_is_not_gui_acceptance": true
  },
  "lifecycle": {
    "quarantine_is_pass": false
  },
  "retry_policy": {
    "outcomes": [
      "PASS",
      "FAIL_PRODUCT",
      "FAIL_TEST_INFRA",
      "BLOCKED_ENVIRONMENT",
      "NOT_RUN"
    ]
  },
  "artifact_smoke": {
    "level": "L5",
    "count": 1,
    "after_source_freeze": true,
    "after_quality_gates": true,
    "after_required_gui": true,
    "exact_bytes_required": true,
    "runtime_health_required": true
  },
  "exceptions": []
}
