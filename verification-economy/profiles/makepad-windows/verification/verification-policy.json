{
  "schema_version": 1,
  "policy_version": "1.0.0",
  "levels": {
    "L0": {
      "title": "Pure/unit"
    },
    "L1": {
      "title": "Owning component"
    },
    "L2": {
      "title": "Integration"
    },
    "L3": {
      "title": "Focused runtime/OS"
    },
    "L4a": {
      "title": "Routine golden"
    },
    "L4b": {
      "title": "Relevant composition"
    },
    "L5": {
      "title": "Frozen smoke"
    }
  },
  "periodic_regression": {
    "interval": 5,
    "state": "UNKNOWN_LEGACY_BASELINE",
    "last_full_gui_milestone": null,
    "milestones_since_last_full": null,
    "next_recommended_full": "next accepted functional closure calibrates registered composition"
  },
